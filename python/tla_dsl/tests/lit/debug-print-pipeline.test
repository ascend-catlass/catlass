// RUN: sed -n '/BEGIN-LOWER$/,/END-LOWER$/p' %s | %tla_compile - -o - | %filecheck %s --check-prefix=LOWER
// RUN: sed -n '/BEGIN-LOWER$/,/END-LOWER$/p' %s | %tla_compile - --emit=mlir --mlir-print-ir-after-all -o /dev/null 2>&1 | %filecheck %s --check-prefix=BRIDGE
// RUN: sed -n '/BEGIN-NOOP$/,/END-NOOP$/p' %s | %tla_compile - --emit=tla-mlir -o - | %filecheck %s --check-prefix=NOOP

// BEGIN-LOWER
module {
  tla.func @debug_print_scalars(%i8: i8, %i16: i16, %v: i32, %u8: ui8, %u16: ui16, %u32: ui32, %h: f16, %f: f32) {
    "tla.cube"() ({ tla.debug_print %i8 : i8 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %i16 : i16 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %v : i32 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %u8 : ui8 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %u16 : ui16 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %u32 : ui32 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %h : f16 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %f : f32 }) : () -> ()
    tla.return
  }
  tla.func @debug_print_formatted_aic(%i8: i8, %i16: i16, %v: i32, %u8: ui8, %u16: ui16, %u32: ui32, %h: f16, %f: f32) {
    "tla.cube"() ({
      tla.debug_print format "hello"() : ()
      tla.debug_print format "all={} {} {} {} {} {} {} {}"(%i8, %i16, %v, %u8, %u16, %u32, %h, %f) : (i8, i16, i32, ui8, ui16, ui32, f16, f32)
      tla.debug_print format "x={}"(%v) : (i32)
      tla.debug_print format "v={}"(%f) : (f32)
      tla.debug_print format "x={} v={}"(%v, %f) : (i32, f32)
      tla.debug_print format "progress=50% {}"(%v) : (i32)
      tla.debug_print format "braces={{}} {}"(%v) : (i32)
      tla.debug_print format "again {}"(%v) : (i32)
      tla.debug_print format "again {}"(%v) : (i32)
    }) : () -> ()
    tla.return
  }
  tla.func @debug_print_formatted_aiv(%v: i32, %f: f32) {
    "tla.vector"() ({
      tla.debug_print format "hello"() : ()
      tla.debug_print format "x={}"(%v) : (i32)
      tla.debug_print format "v={}"(%f) : (f32)
      tla.debug_print format "x={} v={}"(%v, %f) : (i32, f32)
      tla.debug_print format "progress=50% {}"(%v) : (i32)
      tla.debug_print format "braces={{}} {}"(%v) : (i32)
    }) : () -> ()
    tla.return
  }
}
// END-LOWER
