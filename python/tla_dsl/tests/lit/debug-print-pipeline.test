// BEGIN-NOOP
module { tla.func @without_debug_print() { tla.return } }
// END-NOOP
// NOOP: func.func @without_debug_print

// RUN: sed -n '/BEGIN-WORKSPACE-ONCE$/,/END-WORKSPACE-ONCE$/p' %s | %tla_compile - -o - | %filecheck %s --check-prefix=ONCE

// BEGIN-WORKSPACE-ONCE
module {
  tla.func @debug_print_workspace_once(%v: i32, %f: f32) {
    "tla.vector"() ({
      tla.debug_print %v : i32
      tla.debug_print format "x={}"(%v) : (i32)
      tla.debug_print format "v={}"(%f) : (f32)
      tla.debug_print %f : f32
    }) : () -> ()
    tla.return
  }
}
// END-WORKSPACE-ONCE
// ONCE-COUNT-1: tla.debug_print.workspace
// ONCE: call @_mlir_ciface_tla_printf_x_i32(%{{.*}}, %[[WORKSPACE:arg[0-9]+]])
// ONCE: call @_mlir_ciface_tla_printf_format_values(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %[[WORKSPACE]])
// ONCE: call @_mlir_ciface_tla_printf_format_values(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %[[WORKSPACE]])
// ONCE: call @_mlir_ciface_tla_printf_v_f32(%{{.*}}, %[[WORKSPACE]])
