// Every input in this test is emitted by a legal Python @tla.kernel. Do not add
// hand-written IR that bypasses frontend validation.
// RUN: %python %S/Inputs/generate_mmad_ir.py f16 | %tla_compile - -o - | %filecheck %s --check-prefix=F16
// RUN: %python %S/Inputs/generate_mmad_ir.py bf16 | %tla_compile - -o - | %filecheck %s --check-prefix=BF16
// RUN: %python %S/Inputs/generate_mmad_ir.py f32 | %tla_compile - -o - | %filecheck %s --check-prefix=F32
// RUN: %python %S/Inputs/generate_mmad_ir.py i8 | %tla_compile - -o - | %filecheck %s --check-prefix=I8
// RUN: %python %S/Inputs/generate_mmad_ir.py i8-fixpipe | %tla_compile - -o - | %filecheck %s --check-prefix=I8FIX
// RUN: %python %S/Inputs/generate_mmad_ir.py fp8 | %tla_compile - -o - | %filecheck %s --check-prefix=FP8
// RUN: %python %S/Inputs/generate_mmad_ir.py fp8-mixed | %tla_compile - -o - | %filecheck %s --check-prefix=FP8MIX
// RUN: %python %S/Inputs/generate_mmad_ir.py mx | %tla_compile - -o - | %filecheck %s --check-prefix=MX
// RUN: %python %S/Inputs/generate_mmad_ir.py mx-mixed | %tla_compile - -o - | %filecheck %s --check-prefix=MXMIX
// RUN: %python %S/Inputs/generate_mmad_ir.py mxfp4 | %tla_compile - -o - | %filecheck %s --check-prefix=MXFP4
// RUN: %python %S/Inputs/generate_mmad_ir.py mxfp4-e1m2 | %tla_compile - -o - | %filecheck %s --check-prefix=MXFP4B
// RUN: %python %S/Inputs/generate_mmad_ir.py dynamic-init | %tla_compile - -o - | %filecheck %s --check-prefix=DYN-INIT
// RUN: %python %S/Inputs/generate_mmad_ir.py dynamic-unit | %tla_compile - -o - | %filecheck %s --check-prefix=DYN-UNIT
// RUN: %python %S/Inputs/generate_mmad_ir.py dynamic-both | %tla_compile - -o - | %filecheck %s --check-prefix=DYN-BOTH

// F16-COUNT-1: func.func private @mmad_half_half_float(
// F16-SAME: hacc.always_inline
// F16-SAME: hivm.func_core_type = #hivm.func_core_type<AIC>
// F16-SAME: llvm.emit_c_interface
// F16-LABEL: func.func @_static_f16_mmad_kernel(
// F16-DAG: [[INIT:%.*]] = llvm.mlir.constant(true) : i1
// F16-DAG: [[UNIT:%.*]] = llvm.mlir.constant(3 : i8) : i8
// F16-DAG: [[M:%.*]] = llvm.mlir.constant(128 : i64) : i64
// F16-DAG: [[K:%.*]] = llvm.mlir.constant(64 : i64) : i64
// F16: call @mmad_half_half_float({{%.*}}, {{%.*}}, {{%.*}}, [[M]], [[M]], [[K]], [[INIT]], [[UNIT]])
// F16-NOT: tla.mmad

// BF16-COUNT-1: func.func private @mmad_bf16_bf16_float(
// BF16-LABEL: func.func @_static_bf16_mmad_kernel(
// BF16-DAG: [[INIT:%.*]] = llvm.mlir.constant(true) : i1
// BF16-DAG: [[UNIT:%.*]] = llvm.mlir.constant(3 : i8) : i8
// BF16-DAG: [[M:%.*]] = llvm.mlir.constant(128 : i64) : i64
// BF16-DAG: [[K:%.*]] = llvm.mlir.constant(64 : i64) : i64
// BF16: call @mmad_bf16_bf16_float({{%.*}}, {{%.*}}, {{%.*}}, [[M]], [[M]], [[K]], [[INIT]], [[UNIT]])
// BF16-NOT: tla.mmad

// F32-COUNT-1: func.func private @mmad_float_float_float(
// F32-LABEL: func.func @_static_f32_mmad_kernel(
// F32-DAG: [[INIT:%.*]] = llvm.mlir.constant(true) : i1
// F32-DAG: [[UNIT:%.*]] = llvm.mlir.constant(3 : i8) : i8
// F32-DAG: [[MN:%.*]] = llvm.mlir.constant(32 : i64) : i64
// F32-COUNT-1: call @_mlir_ciface_tla_init_soc_state_aic()
// F32: call @mmad_float_float_float({{%.*}}, {{%.*}}, {{%.*}}, [[MN]], [[MN]], [[MN]], [[INIT]], [[UNIT]])
// F32-NOT: tla.mmad

// I8-COUNT-1: func.func private @mmad_int8_int8_int32(
// I8-SAME: hacc.always_inline
// I8-SAME: hivm.func_core_type = #hivm.func_core_type<AIC>
// I8-SAME: llvm.emit_c_interface
// I8-LABEL: func.func @_static_i8_mmad_kernel(
// I8-DAG: [[INIT:%.*]] = llvm.mlir.constant(true) : i1
// I8-DAG: [[UNIT:%.*]] = llvm.mlir.constant(3 : i8) : i8
// I8-DAG: [[M:%.*]] = llvm.mlir.constant(128 : i64) : i64
// I8-DAG: [[K:%.*]] = llvm.mlir.constant(64 : i64) : i64
// I8: call @mmad_int8_int8_int32({{%.*}}, {{%.*}}, {{%.*}}, [[M]], [[M]], [[K]], [[INIT]], [[UNIT]])
// I8-NOT: tla.mmad

// Every way out of an i32 accumulator. An i32 L0C has no narrowing path, so each
// copy must resolve to an int32_t -> int32_t callee, never an fp32 one.
// I8FIX-DAG: func.func private @mmad_int8_int8_int32(
// I8FIX-DAG: func.func private @copy_l0c_to_gm_RowMajor_int32_t_int32_t(
// I8FIX-DAG: func.func private @copy_l0c_to_ub_RowMajor_splitm_int32_t_int32_t(
// I8FIX-DAG: func.func private @copy_l0c_to_l1_zN_int32_t_int32_t(
// I8FIX: call @mmad_int8_int8_int32(
// I8FIX-DAG: call @copy_l0c_to_gm_RowMajor_int32_t_int32_t(
// I8FIX-DAG: call @copy_l0c_to_ub_RowMajor_splitm_int32_t_int32_t(
// I8FIX-DAG: call @copy_l0c_to_l1_zN_int32_t_int32_t(
// I8FIX-NOT: tla.mmad
// I8FIX-NOT: tla.copy

// The frontend spells the MX load as tla.copy(scale=...), which lowers to
// tla.copy_mx, and the matmul as tla.mmad_mx -- both are written by the user;
// neither is inferred. Compare the FP8 prefix above, whose kernel is identical
// apart from the loads carrying no scale and the matmul being tla.mmad, and
// which therefore stays on mad.
// MX-DAG: func.func private @copy_mx_l1_zN_to_l0a_zN_fp8_e4m3fn_t(
// MX-DAG: func.func private @copy_mx_l1_nZ_to_l0b_nZ_fp8_e4m3fn_t(
// MX-DAG: func.func private @mmadmx_mx_fp8_e4m3_t_mx_fp8_e4m3_t_float(
// MX: call @copy_mx_l1_zN_to_l0a_zN_fp8_e4m3fn_t(
// MX: call @copy_mx_l1_nZ_to_l0b_nZ_fp8_e4m3fn_t(
// MX: call @mmadmx_mx_fp8_e4m3_t_mx_fp8_e4m3_t_float(
// MX-NOT: tla.copy_mx
// MX-NOT: tla.mmad

// The two fp8 formats mix, so the callee name is per-operand.
// MXMIX-DAG: func.func private @mmadmx_mx_fp8_e5m2_t_mx_fp8_e4m3_t_float(
// MXMIX: call @mmadmx_mx_fp8_e5m2_t_mx_fp8_e4m3_t_float(
// MXMIX-NOT: tla.mmad

// Packed fp4: the encoding cannot be read off the element type (the tile is i8
// storage), so it is taken from the load and threaded into the callee name.
// MXFP4-DAG: func.func private @copy_mx_l1_zN_to_l0a_zN_float4_e2m1x2_t(
// MXFP4-DAG: func.func private @copy_mx_l1_nZ_to_l0b_nZ_float4_e2m1x2_t(
// MXFP4-DAG: func.func private @mmadmx_float4_e2m1x2_t_float4_e2m1x2_t_float(
// MXFP4: call @mmadmx_float4_e2m1x2_t_float4_e2m1x2_t_float(
// MXFP4-NOT: tla.copy_mx
// MXFP4-NOT: tla.mmad

// MXFP4B-DAG: func.func private @mmadmx_float4_e1m2x2_t_float4_e1m2x2_t_float(
// MXFP4B: call @mmadmx_float4_e1m2x2_t_float4_e1m2x2_t_float(
// MXFP4B-NOT: tla.mmad

// DYN-INIT-COUNT-1: func.func private @mmad_float_float_float(
// DYN-INIT-LABEL: func.func @_dynamic_init_mmad_kernel(
// DYN-INIT: call @mmad_float_float_float({{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}})
// DYN-INIT-NOT: tla.mmad

// DYN-UNIT-COUNT-1: func.func private @mmad_float_float_float(
// DYN-UNIT-LABEL: func.func @_dynamic_unit_mmad_kernel(
// DYN-UNIT: call @mmad_float_float_float({{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}})
// DYN-UNIT-NOT: tla.mmad

// DYN-BOTH-COUNT-1: func.func private @mmad_float_float_float(
// DYN-BOTH-LABEL: func.func @_dynamic_init_unit_mmad_kernel(
// DYN-BOTH: call @mmad_float_float_float({{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}}, {{%.*}})
// DYN-BOTH-NOT: tla.mmad

// FP8-COUNT-1: func.func private @mmad_fp8_e4m3fn_t_fp8_e4m3fn_t_float(
// FP8-SAME: hivm.func_core_type = #hivm.func_core_type<AIC>
// FP8-DAG: [[M:%.*]] = llvm.mlir.constant(128 : i64) : i64
// FP8-DAG: [[K:%.*]] = llvm.mlir.constant(64 : i64) : i64
// FP8: call @mmad_fp8_e4m3fn_t_fp8_e4m3fn_t_float({{%.*}}, {{%.*}}, {{%.*}}, [[M]], [[M]], [[K]]
// FP8-NOT: tla.mmad

// The two fp8 formats mix, so the callee name is per-operand.
// FP8MIX-COUNT-1: func.func private @mmad_fp8_e4m3fn_t_fp8_e5m2_t_float(
// FP8MIX: call @mmad_fp8_e4m3fn_t_fp8_e5m2_t_float(
// FP8MIX-NOT: tla.mmad
