// RUN: sed -n '/BEGIN-GM$/,/END-GM$/p' %s | %tla_compile - -o - | %filecheck %s --check-prefix=GM
// RUN: sed -n '/BEGIN-UB$/,/END-UB$/p' %s | %tla_compile - -o - | %filecheck %s --check-prefix=UB
// RUN: sed -n '/BEGIN-CUBE$/,/END-CUBE$/p' %s | %tla_compile - -o - | %filecheck %s --check-prefix=CUBE

// BEGIN-GM
module {
  tla.func @print_tensor_mixed_gm(%x: !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>, %tag: i32) {
    %c4 = arith.constant 4 : i64
    "tla.cube"() ({
      %one = arith.constant 1 : i32
      %unused = arith.addi %tag, %one : i32
    }) : () -> ()
    "tla.vector"() ({
      tla.print_tensor %x length = %c4 shape = [4, 4] : !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>, i64
    }) : () -> ()
    tla.return
  }
}
// END-GM

// GM-LABEL: func.func @print_tensor_mixed_gm_mix_aic(
// GM-SAME: %arg0: memref<4x4xf32, #hivm.address_space<gm>>, %arg1: i32,
// GM-SAME: %[[AIC_WORKSPACE:arg[0-9]+]]: i64 {{.*}}hacc.arg_type = #hacc.arg_type<workspace>{{.*}}tla.print_tensor.workspace
// GM-LABEL: func.func @print_tensor_mixed_gm_mix_aiv(
// GM-SAME: %arg0: memref<4x4xf32, #hivm.address_space<gm>>, %arg1: i32,
// GM-SAME: %[[AIV_WORKSPACE:arg[0-9]+]]: i64 {{.*}}hacc.arg_type = #hacc.arg_type<workspace>{{.*}}tla.print_tensor.workspace
// GM: call @_mlir_ciface_tla_print_tensor_gm_f32_aiv(%[[AIV_WORKSPACE]], {{.*}}, {{.*}}, {{.*}}, {{.*}})
// GM-NOT: _mlir_ciface_tla_print_tensor_ub_f32
// GM-NOT: tla.print_tensor

// BEGIN-UB
module {
  tla.func @print_tensor_mixed_ub(%input: !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>, %tag: i32) {
    %raw = tla.alloc_ptr{size_bytes = 64} -> !tla.ptr<i8, ub, 32>
    %ptr = tla.recast_ptr %raw : !tla.ptr<i8, ub, 32> -> !tla.ptr<f32, ub, 32>
    %shape = tla.make_shape -> !tla.shape<4,4>
    %stride = tla.make_stride -> !tla.stride<4,1>
    %layout = tla.make_layout %shape, %stride : !tla.shape<4,4>, !tla.stride<4,1> -> !tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>
    %coord = tla.make_coord -> !tla.coord<0,0>
    %x = tla.make_tensor %ptr, %layout, %coord : !tla.ptr<f32, ub, 32>, !tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0> -> !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, ub, 32>>
    %c4 = arith.constant 4 : i64
    "tla.cube"() ({
      %one = arith.constant 1 : i32
      %unused = arith.addi %tag, %one : i32
    }) : () -> ()
    "tla.vector"() ({
      tla.print_tensor %x length = %c4 shape = [4, 4] : !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, ub, 32>>, i64
    }) : () -> ()
    tla.return
  }
}
// END-UB

