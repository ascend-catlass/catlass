      tla.print_tensor %x length = %c4 shape = [4, 4] : !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>, i64
    }) : () -> ()
    "tla.vector"() ({
