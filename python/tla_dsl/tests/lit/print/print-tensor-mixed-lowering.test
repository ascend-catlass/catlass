// BEGIN-CUBE
module {
  tla.func @print_tensor_mixed_cube(%x: !tla.tensor<!tla.layout<!tla.shape<4,4>, !tla.stride<4,1>, !tla.shape<4,4>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>, %tag: i32) {
