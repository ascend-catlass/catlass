// Mutex IDs and the 32-ID limit are independent for the Cube and Vector sides.
// RUN: split-file %s %t
// RUN: %tla_compile %t/per-core.mlir -o %t/per-core.o --mlir-print-ir-after=tla-insert-auto-mutex 2>&1 | %filecheck %s --check-prefix=PER-CORE
// RUN: not %tla_compile %t/id-limit.mlir -o - 2>&1 | %filecheck %s --check-prefix=ID-LIMIT

// PER-CORE-LABEL: func.func @auto_mutex_per_core_id_space
// PER-CORE: tla.mutex "auto_l0a_0_4096" {id = 0 : i64} -> !tla.mutex
// PER-CORE: tla.mutex "auto_l0c_0_4096" {id = 2 : i64} -> !tla.mutex
// PER-CORE: tla.mutex "auto_ub_0_256" {id = 0 : i64} -> !tla.mutex
// PER-CORE: tla.mutex "auto_ub_7424_256" {id = 29 : i64} -> !tla.mutex
// ID-LIMIT: automatic mutex requires 33 IDs for the vector side, exceeding the per-core hardware limit of 32

//--- per-core.mlir

!gm = !tla.tensor<!tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f32, gm, 4>>
!l0a = !tla.tensor<!tla.layout<!tla.shape<(16,2),(8,4)>, !tla.stride<(8,128),(1,256)>, !tla.shape<32,32>, zN>, !tla.coord<0,0>, !tla.ptr<f32, l0a, 512>>
!l0b = !tla.tensor<!tla.layout<!tla.shape<(8,4),(16,2)>, !tla.stride<(1,256),(8,128)>, !tla.shape<32,32>, nZ>, !tla.coord<0,0>, !tla.ptr<f32, l0b, 512>>
!l0c = !tla.tensor<!tla.layout<!tla.shape<(16,2),(16,2)>, !tla.stride<(16,256),(1,512)>, !tla.shape<32,32>, L0Clayout>, !tla.coord<0,0>, !tla.ptr<f32, l0c, 1024>>
!ub_layout = !tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>
!ub_coord = !tla.coord<0>
!ub = !tla.tensor<!ub_layout, !ub_coord, !tla.ptr<f32, ub, 256>>
!gm_ub = !tla.tensor<!ub_layout, !ub_coord, !tla.ptr<f32, gm, 4>>

module {
  tla.func @auto_mutex_per_core_id_space(%gm: !gm, %gm_ub: !gm_ub) attributes {tla.auto_sync = "v0"} {
    %pa = tla.alloc_ptr{size_bytes = 4096} -> !tla.ptr<f32, l0a, 512>
    %pb = tla.alloc_ptr{size_bytes = 4096} -> !tla.ptr<f32, l0b, 512>
    %pc = tla.alloc_ptr{size_bytes = 4096} -> !tla.ptr<f32, l0c, 1024>
    %a = "tla.make_tensor_like"(%pa, %gm) {layoutTag = #tla.layout_tag<zN>} : (!tla.ptr<f32, l0a, 512>, !gm) -> !l0a
    %b = "tla.make_tensor_like"(%pb, %gm) {layoutTag = #tla.layout_tag<nZ>} : (!tla.ptr<f32, l0b, 512>, !gm) -> !l0b
    %c = "tla.make_tensor_like"(%pc, %gm) {layoutTag = #tla.layout_tag<L0Clayout>} : (!tla.ptr<f32, l0c, 1024>, !gm) -> !l0c
