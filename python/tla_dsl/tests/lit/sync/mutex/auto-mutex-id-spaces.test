// The function uses 33 mutexes in total, but the per-core limits are Cube=3
// and Vector=30, so both independent ID spaces are valid.

//--- id-limit.mlir
!limit_layout = !tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>
!limit_coord = !tla.coord<0>
!limit_ub = !tla.tensor<!limit_layout, !limit_coord, !tla.ptr<f32, ub, 256>>
!limit_gm = !tla.tensor<!limit_layout, !limit_coord, !tla.ptr<f32, gm, 4>>

