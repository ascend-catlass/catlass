//   func.func @exch_i32(%dst_memref: memref<8xi32, #hivm.address_space<gm>>) {
//     %c0 = arith.constant 0 : index
//     %c1 = arith.constant 1 : index
//     %c8 = arith.constant 8 : index
//     %dst = tla.tensor_desc %dst_memref shape [%c1, %c8, %c1, %c1] stride [%c8, %c1, %c1, %c1] origin_shape [%c1, %c8] coord [%c0, %c0] : memref<8xi32, #hivm.address_space<gm>> -> !gm_i32
//     "tla.vector"() ({
//       %p = tla.tensor_ptr %dst : !gm_i32 -> !tla.ptr<i32, gm, 4>
//       %one = arith.constant 1 : i32
//       %old = tla.simd_atomic_exch %p, %one : !tla.ptr<i32, gm, 4>, i32 -> i32
//       tla.scalar_store %dst[%c0], %old : !gm_i32, i32
//     }) : () -> ()
//     return
//   }
// }
// END_EXCH_I32

// RUN: sed -n '/^\/\/ BEGIN_VEC_FUNC$/,/^\/\/ END_VEC_FUNC$/p' %s | sed '1d;$d;s|^// ||' > %t.VEC_FUNC.mlir && not %tla_compile %t.VEC_FUNC.mlir -o %t 2>&1 | %filecheck %s --check-prefix=VEC_FUNC
// VEC_FUNC: error: 'tla.simd_atomic_add' op SIMD atomic operations must not be nested inside a tla.vec.func

// BEGIN_VEC_FUNC
// !gm_i32 = !tla.tensor<!tla.layout<!tla.shape<8>, !tla.stride<1>, !tla.shape<8>, RowMajor>, !tla.coord<0>, !tla.ptr<i32, gm, 4>>
// module {
//   func.func @simd_vec_func(%dst_memref: memref<8xi32, #hivm.address_space<gm>>) {
//     %c0 = arith.constant 0 : index
//     %c1 = arith.constant 1 : index
//     %c8 = arith.constant 8 : index
//     %dst = tla.tensor_desc %dst_memref shape [%c1, %c8, %c1, %c1] stride [%c8, %c1, %c1, %c1] origin_shape [%c1, %c8] coord [%c0, %c0] : memref<8xi32, #hivm.address_space<gm>> -> !gm_i32
//     "tla.vector"() ({
//       "tla.vec.func"() ({
//         %p = tla.tensor_ptr %dst : !gm_i32 -> !tla.ptr<i32, gm, 4>
//         %one = arith.constant 1 : i32
//         %old = tla.simd_atomic_add %p, %one : !tla.ptr<i32, gm, 4>, i32 -> i32
//         tla.scalar_store %dst[%c0], %old : !gm_i32, i32
//       }) {mode = "simd"} : () -> ()
//     }) : () -> ()
//     return
//   }
// }
// END_VEC_FUNC

