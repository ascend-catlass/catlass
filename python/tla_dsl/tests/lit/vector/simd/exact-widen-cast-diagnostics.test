// RUN: sed -n '/BEGIN-E5M2$/,/END-E5M2$/p' %s | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=E5M2
// RUN: sed -n '/BEGIN-U8$/,/END-U8$/p' %s | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=U8
// RUN: sed -n '/BEGIN-E5M2$/,/END-E5M2$/p' %s | sed 's/0, 0, 5/0, 1, 4/' | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=E5M2
// RUN: sed -n '/BEGIN-U8$/,/END-U8$/p' %s | sed 's/0, 0, 5/0, 2, 4/' | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=U8
// RUN: sed -n '/BEGIN-I32$/,/END-I32$/p' %s | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=I32
// RUN: sed -n '/BEGIN-F16$/,/END-F16$/p' %s | not %tla_compile - -o %t.out 2>&1 | %filecheck %s --check-prefix=F16

// E5M2: 'f8E5M2'->'f16' requires CAST_NONE and SatMode.UNKNOWN
// U8: 'ui8'->'f32' requires CAST_NONE and SatMode.UNKNOWN
// I32: 'i32'->'i64' requires CAST_NONE and SatMode.UNKNOWN
// F16: 'f16'->'f32' requires CAST_NONE and SatMode.UNKNOWN

// BEGIN-E5M2
func.func @bad(%v: !tla.vector<256xf8E5M2>) {
  "tla.vec.func"() ({
    %r = tla.cast %v, [0, 0, 5] : !tla.vector<256xf8E5M2> -> !tla.vector<128xf16>
  }) {mode = "simd"} : () -> ()
  return
}
// END-E5M2

// BEGIN-U8
func.func @bad(%v: !tla.vector<256xui8>) {
  "tla.vec.func"() ({
    %r = tla.cast %v, [0, 0, 5] : !tla.vector<256xui8> -> !tla.vector<64xf32>
  }) {mode = "simd"} : () -> ()
  return
}
// END-U8

// BEGIN-I32
func.func @bad(%v: !tla.vector<64xi32>) {
  "tla.vec.func"() ({
    %r = tla.cast %v, [1, 0, 3] : !tla.vector<64xi32> -> !tla.vector<32xi64>
  }) {mode = "simd"} : () -> ()
  return
}
// END-I32

// BEGIN-F16
func.func @bad(%v: !tla.vector<128xf16>) {
  "tla.vec.func"() ({
    %r = tla.cast %v, [0, 1, 4] : !tla.vector<128xf16> -> !tla.vector<64xf32>
  }) {mode = "simd"} : () -> ()
  return
}
// END-F16
