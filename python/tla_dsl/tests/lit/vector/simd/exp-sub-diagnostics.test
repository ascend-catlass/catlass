// END_BFLOAT

// RESULT_ELEM: requires a 64-lane f32 result vector
// BEGIN_RESULT_ELEM
// module {
//   func.func @invalid(%lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xf32>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = tla.exp_sub %lhs, %rhs mask %mask part 0 : !tla.vector<64xf32>, !tla.vector<64xf32> mask !tla.mask<64> -> !tla.vector<64xf16>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_RESULT_ELEM

// HALF_OVERSIZE: tla.vector valid lane count must be in [1, 128]
// BEGIN_HALF_OVERSIZE
// module {
//   func.func @invalid(%lhs: !tla.vector<129xf16>, %mask: !tla.mask<128>) {
//     "tla.vec.func"() ({
//       %result = tla.exp_sub %lhs, %lhs mask %mask part 0 : !tla.vector<129xf16>, !tla.vector<129xf16> mask !tla.mask<128> -> !tla.vector<64xf32>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_HALF_OVERSIZE

