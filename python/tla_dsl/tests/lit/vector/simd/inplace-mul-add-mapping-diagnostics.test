// RUN: not %tla_compile %s -o %t 2>&1 | %filecheck %s

!tile = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f32, ub, 32>>
!ub = memref<64xf32, #hivm.address_space<ub>>
!vec = !tla.vector<64xf32>
!mask = !tla.mask<64>

func.func @external_operands(%mem: !ub, %external_vec: !vec, %external_mask: !mask) {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %cn = arith.constant 64 : index
  %out = tla.tensor_desc %mem shape [%c1, %cn, %c1, %c1] stride [%cn, %c1, %c1, %c1] origin_shape [%c1, %cn] coord [%c0, %c0] : !ub -> !tile
  "tla.vec.func"() ({
    %v = tla.load %out : !tile -> !vec
    %r = tla.inplace_mul_add %external_vec, %v, %v : !vec
    tla.store %out, %r : !tile, !vec
  }) : () -> ()
  "tla.vec.func"() ({
    %v = tla.load %out : !tile -> !vec
    %r = tla.inplace_mul_add %v, %v, %v mask %external_mask : !vec mask !mask
    tla.store %out, %r : !tile, !vec
  }) : () -> ()
  return
}

// CHECK-DAG: error: inplace_mul_add operand #0 requires a vector or mask produced inside the SIMD region
// CHECK-DAG: error: inplace_mul_add operand #3 requires a vector or mask produced inside the SIMD region
