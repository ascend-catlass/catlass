// RUN: sed -n '/^\/\/ BEGIN_TYPE$/,/^\/\/ END_TYPE$/p' %s | sed '1d;$d;s|^// ||' > %t.TYPE.mlir && not %tla_compile %t.TYPE.mlir -o %t 2>&1 | %filecheck %s --check-prefix=TYPE
// RUN: sed -n '/^\/\/ BEGIN_RESULT$/,/^\/\/ END_RESULT$/p' %s | sed '1d;$d;s|^// ||' > %t.RESULT.mlir && not %tla_compile %t.RESULT.mlir -o %t 2>&1 | %filecheck %s --check-prefix=RESULT
// RUN: sed -n '/^\/\/ BEGIN_LANES$/,/^\/\/ END_LANES$/p' %s | sed '1d;$d;s|^// ||' > %t.LANES.mlir && not %tla_compile %t.LANES.mlir -o %t 2>&1 | %filecheck %s --check-prefix=LANES
// RUN: sed -n '/^\/\/ BEGIN_WIDTH$/,/^\/\/ END_WIDTH$/p' %s | sed '1d;$d;s|^// ||' > %t.WIDTH.mlir && not %tla_compile %t.WIDTH.mlir -o %t 2>&1 | %filecheck %s --check-prefix=WIDTH
// RUN: sed 's/64xi8/64xsi16/g' %t.WIDTH.mlir | not %tla_compile - -o %t 2>&1 | %filecheck %s --check-prefix=SIGNED
// RUN: sed -n '/^\/\/ BEGIN_MASK$/,/^\/\/ END_MASK$/p' %s | sed '1d;$d;s|^// ||' > %t.MASK.mlir && not %tla_compile %t.MASK.mlir -o %t 2>&1 | %filecheck %s --check-prefix=MASK
// RUN: sed -n '/^\/\/ BEGIN_SIMT$/,/^\/\/ END_SIMT$/p' %s | sed '1d;$d;s|^// ||' > %t.SIMT.mlir && not %tla_compile %t.SIMT.mlir -o %t 2>&1 | %filecheck %s --check-prefix=SIMT
// RUN: sed -n '/^\/\/ BEGIN_OUTSIDE$/,/^\/\/ END_OUTSIDE$/p' %s | sed '1d;$d;s|^// ||' > %t.OUTSIDE.mlir && not %tla_compile %t.OUTSIDE.mlir -o %t 2>&1 | %filecheck %s --check-prefix=OUTSIDE
// RUN: sed 's/tla.func @/func.func @/;s/tla.return/return/' %t.OUTSIDE.mlir | %tla_compile - --emit=tlair -o - | %filecheck %s --check-prefix=LOWERED

// TYPE: requires all inputs
// BEGIN_TYPE
// module {
//   func.func @invalid(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xi32>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<64xi32>, !tla.mask<64>) -> !tla.vector<64xf32>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_TYPE

// RESULT: requires all inputs
// BEGIN_RESULT
// module {
//   func.func @invalid(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xf32>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<64xf32>, !tla.mask<64>) -> !tla.vector<32xf32>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_RESULT

// LANES: requires all inputs
// BEGIN_LANES
// module {
//   func.func @invalid(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<32xf32>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<32xf32>, !tla.mask<64>) -> !tla.vector<64xf32>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_LANES

// WIDTH: unsupported element type {{.*}}i8{{.*}}; supported element types are bf16, f16, f32, i16, i32, i64, ui16, ui32, ui64
// SIGNED: unsupported element type {{.*}}si16{{.*}}; supported element types are bf16, f16, f32, i16, i32, i64, ui16, ui32, ui64
// BEGIN_WIDTH
// module {
//   func.func @invalid(%acc: !tla.vector<64xi8>, %lhs: !tla.vector<64xi8>, %rhs: !tla.vector<64xi8>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xi8>, !tla.vector<64xi8>, !tla.vector<64xi8>, !tla.mask<64>) -> !tla.vector<64xi8>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_WIDTH

// MASK: mask has 128
// BEGIN_MASK
// module {
//   func.func @invalid(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xf32>, %mask: !tla.mask<128>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<64xf32>, !tla.mask<128>) -> !tla.vector<64xf32>
//     }) {mode = "simd"} : () -> ()
//     return
//   }
// }
// END_MASK

// SIMT: only supported
// BEGIN_SIMT
// module {
//   func.func @invalid(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xf32>, %mask: !tla.mask<64>) {
//     "tla.vec.func"() ({
//       %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<64xf32>, !tla.mask<64>) -> !tla.vector<64xf32>
//     }) {mode = "simt", thread_block_dim = array<i64: 32, 1, 1>} : () -> ()
//     return
//   }
// }
// END_SIMT

// OUTSIDE: 'tla.mul_inplace_add' op must be nested inside a tla.vec.func region
// LOWERED: tla.mul_inplace_add
// BEGIN_OUTSIDE
// module {
//   tla.func @scope(%acc: !tla.vector<64xf32>, %lhs: !tla.vector<64xf32>, %rhs: !tla.vector<64xf32>, %mask: !tla.mask<64>) {
//     %result = "tla.mul_inplace_add"(%acc, %lhs, %rhs, %mask) : (!tla.vector<64xf32>, !tla.vector<64xf32>, !tla.vector<64xf32>, !tla.mask<64>) -> !tla.vector<64xf32>
//     tla.return
//   }
// }
// END_OUTSIDE
