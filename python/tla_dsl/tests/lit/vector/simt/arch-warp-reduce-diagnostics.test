// RUN: sed -n '/^\/\/ BEGIN_OUTSIDE$/,/^\/\/ END_OUTSIDE$/p' %s | sed '1d;$d;s|^// ||' > %t.OUTSIDE.mlir && not %tla_compile %t.OUTSIDE.mlir -o %t 2>&1 | %filecheck %s --check-prefix=OUTSIDE
// OUTSIDE: error:
// OUTSIDE-SAME: simt
// BEGIN_OUTSIDE
// module {
//   func.func @bad(%v: i32) {
//         %r = tla.arch.warp_reduce "add" %v : i32
//     return
//   }
// }
// END_OUTSIDE

// RUN: sed -n '/^\/\/ BEGIN_SIMD$/,/^\/\/ END_SIMD$/p' %s | sed '1d;$d;s|^// ||' > %t.SIMD.mlir && not %tla_compile %t.SIMD.mlir -o %t 2>&1 | %filecheck %s --check-prefix=SIMD
// SIMD: error:
// SIMD-SAME: simt
// BEGIN_SIMD
// module {
//   func.func @bad(%v: i32) {
//     "tla.vector"() ({
//       "tla.vec.func"() ({
//         %r = tla.arch.warp_reduce "add" %v : i32
//       }) {mode = "simd"} : () -> ()
//     }) : () -> ()
//     return
//   }
// }
// END_SIMD

// RUN: sed -n '/^\/\/ BEGIN_KIND$/,/^\/\/ END_KIND$/p' %s | sed '1d;$d;s|^// ||' > %t.KIND.mlir && not %tla_compile %t.KIND.mlir -o %t 2>&1 | %filecheck %s --check-prefix=KIND
// KIND: error:
// KIND-SAME: kind must
// BEGIN_KIND
// module {
//   func.func @bad(%v: i32) {
//     "tla.vector"() ({
//       "tla.vec.func"() ({
//         %r = tla.arch.warp_reduce "sum" %v : i32
//       }) {mode = "simt", thread_block_dim = array<i64: 32, 1, 1>} : () -> ()
//     }) : () -> ()
//     return
//   }
// }
// END_KIND

