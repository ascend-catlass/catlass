// RUN: sed -n '/^\/\/ BEGIN_OUTSIDE$/,/^\/\/ END_OUTSIDE$/p' %s | sed '1d;$d;s|^// ||' > %t.OUTSIDE.mlir && not %tla_compile %t.OUTSIDE.mlir -o %t 2>&1 | %filecheck %s --check-prefix=OUTSIDE
// OUTSIDE: error: 'tla.arch.shuffle' op
// OUTSIDE-SAME: simt
//
// Diagnostic: a shuffle reads another lane's register, which only exists inside
// a SIMT region. The frontend already refuses the call, but nothing stops
// hand-written or generated IR, and the SIMT lowering pass only visits
// mode="simt" functions -- so without this check the op survives the whole
// pipeline unlowered instead of being diagnosed.

// BEGIN_OUTSIDE
// module {
//   func.func @bad_shuffle(%x: f32) -> f32 {
//     %d = arith.constant 1 : i32
//     %y = "tla.arch.shuffle"(%x, %d) <{mode = #tla.shuffle_mode<up>, width = 32 : i32}> : (f32, i32) -> f32
//     return %y : f32
//   }
// }
// END_OUTSIDE

// RUN: sed -n '/^\/\/ BEGIN_VECTOR$/,/^\/\/ END_VECTOR$/p' %s | sed '1d;$d;s|^// ||' > %t.VECTOR.mlir && not %tla_compile %t.VECTOR.mlir -o %t 2>&1 | %filecheck %s --check-prefix=VECTOR
// VECTOR: error: 'tla.arch.shuffle' op
// VECTOR-SAME: simt

// BEGIN_VECTOR
// module {
//   func.func @bad_shuffle() {
//     "tla.vector"() ({
//       %x = arith.constant 1.0 : f32
//       %d = arith.constant 1 : i32
//       %y = "tla.arch.shuffle"(%x, %d) <{mode = #tla.shuffle_mode<up>, width = 32 : i32}> : (f32, i32) -> f32
//     }) : () -> ()
//     return
//   }
// }
// END_VECTOR

// RUN: sed -n '/^\/\/ BEGIN_SIMD$/,/^\/\/ END_SIMD$/p' %s | sed '1d;$d;s|^// ||' > %t.SIMD.mlir && not %tla_compile %t.SIMD.mlir -o %t 2>&1 | %filecheck %s --check-prefix=SIMD
// SIMD: error: 'tla.arch.shuffle' op
// SIMD-SAME: simt

// BEGIN_SIMD
// module {
//   func.func @bad_shuffle() {
//     "tla.vector"() ({
//       "tla.vec.func"() ({
//         %x = arith.constant 1.0 : f32
//         %d = arith.constant 1 : i32
//         %y = "tla.arch.shuffle"(%x, %d) <{mode = #tla.shuffle_mode<up>, width = 32 : i32}> : (f32, i32) -> f32
//       }) {mode = "simd"} : () -> ()
//     }) : () -> ()
//     return
//   }
// }
// END_SIMD

// RUN: sed -n '/^\/\/ BEGIN_DEFAULT_SIMD$/,/^\/\/ END_DEFAULT_SIMD$/p' %s | sed '1d;$d;s|^// ||' > %t.DEFAULT_SIMD.mlir && not %tla_compile %t.DEFAULT_SIMD.mlir -o %t 2>&1 | %filecheck %s --check-prefix=DEFAULT_SIMD
// DEFAULT_SIMD: error: 'tla.arch.shuffle' op
// DEFAULT_SIMD-SAME: simt

// BEGIN_DEFAULT_SIMD
// module {
//   func.func @bad_shuffle() {
//     "tla.vector"() ({
//       "tla.vec.func"() ({
//         %x = arith.constant 1.0 : f32
//         %d = arith.constant 1 : i32
//         %y = "tla.arch.shuffle"(%x, %d) <{mode = #tla.shuffle_mode<up>, width = 32 : i32}> : (f32, i32) -> f32
//       }) : () -> ()
//     }) : () -> ()
//     return
//   }
// }
// END_DEFAULT_SIMD
